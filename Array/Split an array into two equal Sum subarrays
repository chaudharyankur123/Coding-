# 1st solution(Approach)
bool canSplit(vector<int>& arr) {
        int sum1=0;
        int sum2=0;
        int i=0;
        int j=arr.size()-1;
        while(i<=j){
            if(sum1<=sum2)
            sum1+=arr[i++];
            else
            sum2+=arr[j--];
        }
        return sum1==sum2;
    }

# 2nd solution (Approach)
bool canSplit(vector<int>& arr) {
int totalSum=0;
int n=arr.size();
for(int i=0;i<n;i++){
totalSum+=arr[i];
}
if(totalSum%2==1) return false;
int leftSum=0;
for(int i=0;i<n;i++){
leftSum+=arr[i];
if(leftSum==totalSum/2){
return true;
}
}
return false;
}
