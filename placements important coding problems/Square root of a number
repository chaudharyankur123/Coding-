# code using BinarySearch:
long long int floorSqrt(long long int n) {
        // Your code goes here
           long long low=0, high=n,ans=1;
           while(low<=high){
               long long mid=(low+high)/2;
               long long t=mid*mid;
               if(t==n)
                   return mid;
               if(t<n){
                   low=mid+1;
                   ans=mid;
               }
               else{
                   high=mid-1;
               }
           }
           return ans;
    }

